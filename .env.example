# ---------------------------------------------------------------------------
# Roblox Open Cloud Configuration (NON-SECRET SETTINGS)
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your public Roblox User/Group IDs.
#
# RECOMMENDED SECURITY SETUP FOR YOUR API KEY:
#   Do NOT put your API key in .env if you want to keep it out of workspace files.
#   Instead, run:
#       python setup_credentials.py
#   This stores your key encrypted in Windows Credential Manager (keyring).
#   (Optional fallback: set ROBLOX_OPEN_CLOUD_API_KEY in .env or OS env vars.)
#
# Required Open Cloud API Key permissions (https://create.roblox.com/credentials):
#   - Assets API: asset:read, asset:write
#   - Legacy Asset Delivery API: legacy-asset:manage  (needed for raw downloads & Decal->Image unwrapping)

# Optional fallback API key (prefer `python setup_credentials.py` / Windows Credential Manager)
# ROBLOX_OPEN_CLOUD_API_KEY=

# Personal Roblox User ID (Profile URL: https://www.roblox.com/users/<USER_ID>/profile)
# Supports a plain ID or "alias:id" (e.g., ROBLOX_USER_ID=main:12345678)
ROBLOX_USER_ID=

# Optional: multiple personal accounts (comma-separated plain IDs or alias:id)
# ROBLOX_USER_IDS=main:12345678,alt:87654321

# Multiple Roblox Group IDs (comma-separated, plain IDs or alias:id labels)
# Example: ROBLOX_GROUP_IDS=dexite:7154107,client_studio:33445566
ROBLOX_GROUP_IDS=

# Optional fallback creator when working in an unpublished local .rbxl file (CreatorId == 0)
# Accepts: "user", "user:<id_or_alias>", "group:<id_or_alias>", or leave blank
ROBLOX_DEFAULT_CREATOR=

# Optional per-group / per-user API key overrides (prefer storing via setup_credentials.py)
# ROBLOX_OPEN_CLOUD_KEY_GROUP_7154107=
# ROBLOX_OPEN_CLOUD_KEY_USER_87654321=

# Optional timeouts (seconds)
ROBLOX_OPENCLOUD_TIMEOUT=30
ROBLOX_OPENCLOUD_POLL_TIMEOUT=60
